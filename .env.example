# Baked by Linda — environment variables
# Copy to .env.local for local development. Never commit real keys or passwords.

# Postgres for the app (development: the local database from scripts/dev-db.sh).
# Hosting may name it POSTGRES_URL or NEON_DATABASE_URL instead (Vercel integrations); either is read.
DATABASE_URL=postgres://bbl:bbl@localhost:5432/bbl_dev
# Postgres for the integration tests; the tests migrate it and seed it.
TEST_DATABASE_URL=postgres://bbl:bbl@localhost:5432/bbl_test

# The live site address for titles, canonical links, robots.txt and the sitemap (§10.12).
# Unset in development and on previews (they use their own address).
SITE_URL=

# Hero placeholder slides 2–3 (development only, slice 2.1). Automatic in `next dev` and on Vercel previews,
# never on VERCEL_ENV=production. Set to 1 to see them in a local production build (the e2e tests do).
BBL_HERO_PLACEHOLDERS=

# A long random string: mixed into the hash of a visitor's connection for the form send limits (§10.9), so the
# address itself is never stored, and signs the short “message sent” links (§7.4). Any value works in development.
RATE_LIMIT_SALT=
